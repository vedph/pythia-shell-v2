{
  "name": "pythia-shell",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check-libs": "node scripts/check-local-libs.js",
    "build:libs": "node scripts/build-libs.mjs",
    "test:libs": "node scripts/test-libs.mjs",
    "build:cor": "ng build @myrmidon/pythia-core",
    "build:api": "ng build @myrmidon/pythia-api",
    "build:ui": "ng build @myrmidon/pythia-ui",
    "build:dcr": "ng build @myrmidon/pythia-document-reader",
    "build:doc": "ng build @myrmidon/pythia-document-list",
    "build:wrd": "ng build @myrmidon/pythia-word-index",
    "build:sta": "ng build @myrmidon/pythia-stats",
    "build:qbl": "ng build @myrmidon/pythia-query-builder",
    "build:src": "ng build @myrmidon/pythia-search",
    "build:crp": "ng build @myrmidon/pythia-corpus-list",
    "test:api": "ng test @myrmidon/pythia-api --watch=false",
    "test:ui": "ng test @myrmidon/pythia-ui --watch=false",
    "test:dcr": "ng test @myrmidon/pythia-document-reader --watch=false",
    "test:doc": "ng test @myrmidon/pythia-document-list --watch=false",
    "test:wrd": "ng test @myrmidon/pythia-word-index --watch=false",
    "test:sta": "ng test @myrmidon/pythia-stats --watch=false",
    "test:qbl": "ng test @myrmidon/pythia-query-builder --watch=false",
    "test:src": "ng test @myrmidon/pythia-search --watch=false",
    "test:crp": "ng test @myrmidon/pythia-corpus-list --watch=false",
    "build:all": "pnpm run build:libs && ng build",
    "xi18n": "ng extract-i18n --output-path src/locale && xliffmerge --profile xliffmerge.json it"
  },
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@myrmidon/auth-jwt-admin": "^10.0.0",
    "@myrmidon/auth-jwt-login": "^10.0.0",
    "@myrmidon/cadmus-refs-lookup": "^11.0.8",
    "@myrmidon/ngx-mat-tools": "^3.0.1",
    "@myrmidon/ngx-tools": "^3.0.2",
    "@myrmidon/paged-data-browsers": "^6.0.1",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.0",
    "ts-md5": "^2.0.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/localize": "^22.2.1",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.1.2",
    "ng-packagr": "^22.2.1",
    "ngx-i18nsupport": "^0.17.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-arm64-msvc": "^4.64.3"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node"
    }
  }
}
